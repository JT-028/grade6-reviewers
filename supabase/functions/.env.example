# Copy to ignored supabase/functions/.env for LOCAL development only.
# Hosted Edge Functions supply SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# At least 32 random bytes, represented as at least 64 hexadecimal characters.
FAMILY_PIN_PEPPER=
# Exactly 32 random bytes represented as 64 hexadecimal characters.
PAIR_CLAIM_KEY=
